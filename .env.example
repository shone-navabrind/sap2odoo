# SAP OData connection
# SAP Business ByDesign tenant root, with no trailing slash, e.g.:
# https://mytenant.sapbydesign.com
# The extractor appends /sap/byd/odata/<service>.svc itself.
SAP_BASE_URL=https://your-tenant.sapbydesign.com
SAP_USERNAME=your_sap_user
SAP_PASSWORD=your_sap_password

# Optional: only needed for on-prem systems that require a client query param
SAP_CLIENT=

# Optional: verify TLS certs (set to false only for trusted internal test systems)
VERIFY_SSL=true

# Optional: OData page size for $top/$skip pagination
ODATA_PAGE_SIZE=1000

# Optional: bound transactional document extracts (sales orders, purchase orders,
# billing documents) to a date range to avoid pulling a system's entire history.
# Format: YYYY-MM-DD. Leave blank to fetch all.
SAP_DATE_FROM=
SAP_DATE_TO=

# Where generated CSVs are written
OUTPUT_DIR=output

# Where log files are written
LOG_DIR=logs
